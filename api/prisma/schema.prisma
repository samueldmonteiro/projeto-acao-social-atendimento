generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDANT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ATTENDANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Beneficiary {
  id         String                @id @default(uuid())
  fullName   String
  cpf        String                @unique
  email      String?               @unique
  phone      String?
  birthDate  DateTime
  gender     Gender
  categories BeneficiaryCategory[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@map("beneficiaries")
}

model ServiceCategory {
  id     String @id @default(uuid())
  name   String @unique
  prefix String

  beneficiaries BeneficiaryCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}

model BeneficiaryCategory {
  beneficiaryId     String
  serviceCategoryId String
  callCode          String   @unique

  beneficiary     Beneficiary     @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([beneficiaryId, serviceCategoryId])
  @@map("beneficiary_service_categories")
}
